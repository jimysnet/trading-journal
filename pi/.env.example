# --- Firebase (ίδια με το FIREBASE_CONFIG στο Vercel: projectId και apiKey) ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# --- λογαριασμός bot (ίδια με τα secrets TJ_BOT_EMAIL / TJ_BOT_PASSWORD στο GitHub) ---
# Με αυτά το Pi δηλώνει τη διεύθυνσή του στη σελίδα και μεταφέρει το ιστορικό που υπάρχει ήδη στο Firebase.
TJ_BOT_EMAIL=
TJ_BOT_PASSWORD=

# --- η δημόσια https διεύθυνση του Pi (π.χ. από Cloudflare Tunnel) ---
PUBLIC_URL=https://bigtr.example.com

# --- Cloudflare Tunnel (μόνο αν το χρησιμοποιείς: docker compose --profile tunnel up -d) ---
TUNNEL_TOKEN=

# --- προαιρετικά ---
# COINS=BTC,ETH,SOL,XRP,HBAR,DOGE,ADA,AVAX,LINK,SUI,LTC,ZEC,HYPE
# MIN_USD=5000          # κάτω όριο $ ανά εντολή
# DATA_PATH=./data      # πού γράφεται η βάση (π.χ. /mnt/hdd/trading-journal)
# HOST_PORT=8787
